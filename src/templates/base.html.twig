<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Réservez une sortie d'observation des baleines et dauphins avec Ti Baleine.">
    <title>{% block title %}Ti Baleine App{% endblock %}</title>
    <link rel="stylesheet" href="{{ asset('styles/tokens.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/base.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/components/header.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/components/footer.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/components/buttons.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/components/forms.css') }}">
    {% block page_styles %}{% endblock %}
    {% block javascripts %}{{ importmap('app') }}{% endblock %}
</head>
<body>
<div class="site-shell {% block shell_class %}{% endblock %}">
    {% block header %}{% include 'components/header.html.twig' %}{% endblock %}
    <main id="contenu" class="site-main">
        <div class="flash-stack" aria-live="polite">
            {% for type, messages in app.flashes %}
                {% for message in messages %}<div class="flash flash--{{ type }}">{{ message }}</div>{% endfor %}
            {% endfor %}
        </div>
        {% block body %}{% endblock %}
    </main>
    {% block footer %}{% include 'components/footer.html.twig' %}{% endblock %}
</div>
</body>
</html>
