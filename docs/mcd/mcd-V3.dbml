// ============================================================================
// MCD — TI Baleine App — V3
// Source : docs/cahiers_des_charges/Cahier_des_charges_200ping_V3.md
// ============================================================================

Table Utilisateur {
  id int [pk, increment]
  nom varchar
  prenom varchar
  email varchar [not null, unique]
  mot_de_passe varchar
  telephone varchar
  role varchar [not null, default: 'utilisateur'] // utilisateur | employe | administrateur
  profil varchar [not null, default: 'particulier'] // particulier | hotel
}

Table Bateau {
  id int [pk, increment]
  nom varchar [not null]
  capacite int [not null]
}

Table Sortie {
  id int [pk, increment]
  type varchar [not null] // baleine | dauphin | privatisation
  date date [not null]
  heure_depart time [not null]
  duree time [not null]
  bateau int [not null, ref: > Bateau.id]
  etat varchar [not null, default: 'planifiee'] // planifiee | avertie | annulee
}

Table Reservation {
  id int [pk, increment]
  etat varchar [not null, default: 'reservee'] // reservee | realisee | annulee
  statut_paiement varchar [not null, default: 'en_attente_de_paiement'] // en_attente_de_paiement | acompte_paye | integralement_paye | rembourse
  motif_annulation varchar
  nb_adultes int [not null]
  nb_enfants int [not null]
  montant_initial decimal [not null] // base des frais d'annulation, R-98
  montant_total decimal [not null]
  montant_acompte decimal [not null]
  montant_solde decimal [not null]
  utilisateur int [not null, ref: > Utilisateur.id]
  sortie int [not null, ref: > Sortie.id]
}

Table Paiement {
  id int [pk, increment]
  reservation int [not null, ref: > Reservation.id]
  type_operation varchar [not null] // acompte | solde | complement | remboursement
  montant decimal [not null]
  statut varchar [not null, default: 'en_attente'] // en_attente | paye | rembourse
  mode varchar [not null] // en_ligne | sur_place | facturation_hotel
  date_operation datetime [not null]
  reference_transaction varchar
  enregistre_par int [ref: > Utilisateur.id] // patron pour un paiement sur place
}

Table DocumentFinancier {
  id int [pk, increment]
  reservation int [not null, ref: > Reservation.id]
  type varchar [not null] // justificatif_acompte | facture_finale
  reference varchar [not null, unique]
  date_generation datetime [not null]
  emplacement varchar
}

Table Tarif {
  id int [pk, increment]
  type_sortie varchar [not null]
  categorie varchar // adulte | enfant ; null pour privatisation
  bateau int [ref: > Bateau.id]
  montant decimal [not null]
}

Table Notification {
  id int [pk, increment]
  type varchar [not null] // confirmation_reservation | avertissement | annulation | solde
  canal varchar [not null] // sms | email | popup_site | espace_admin
  date_envoi datetime [not null]
  contenu varchar
  utilisateur int [ref: > Utilisateur.id]
  reservation int [ref: > Reservation.id]
  sortie int [ref: > Sortie.id]
}
