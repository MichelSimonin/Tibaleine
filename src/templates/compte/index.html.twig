{% extends 'base.html.twig' %}

{% block title %}Mon compte — Ti Baleine{% endblock %}
{% block page_styles %}<link rel="stylesheet" href="{{ asset('styles/pages/account.css') }}">{% endblock %}

{% block body %}
<section class="account-page page-section">
    <header class="page-heading"><p class="eyebrow">Bonjour {{ app.user.prenom }}</p><h1>Mes réservations</h1></header>
    <div class="reservation-list">
        {% for reservation in reservations %}
            <article class="reservation-card">
                <div class="reservation-main">
                    <div><span class="status status--{{ reservation.etat.value }}">{{ reservation.etat.label }}</span><h2>{{ reservation.sortie.type.label }}</h2></div>
                    <p>Le {{ reservation.sortie.date|date('d/m/Y') }} à {{ reservation.sortie.heureDepart|date('H:i') }} · {{ reservation.sortie.bateau.nom }}</p>
                </div>
                <dl class="reservation-meta">
                    <div><dt>Participants</dt><dd>{{ reservation.nombreParticipants }}</dd></div>
                    <div><dt>Total</dt><dd>{{ reservation.montantInitial|number_format(2, ',', ' ') }} €</dd></div>
                    <div><dt>Paiement</dt><dd>{{ reservation.statutPaiement.label }}</dd></div>
                </dl>
                {% if reservation.documents|length %}
                    <div class="document-links">
                        {% for document in reservation.documents %}<a href="{{ path('app_document_pdf', {id: document.id}) }}">Télécharger {{ document.type.value == 'justificatif_acompte' ? 'le justificatif' : 'la facture' }} PDF</a>{% endfor %}
                    </div>
                {% endif %}
                {% if paiement_solde_ouvert[reservation.id] ?? false %}
                    <form method="post" action="{{ path('app_payer_solde', {id: reservation.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('payer-solde-' ~ reservation.id) }}">
                        <button class="button button--primary button--small" type="submit">Payer le solde en ligne</button>
                    </form>
                {% endif %}
                {% if complement_en_attente[reservation.id] ?? false %}
                    <form method="post" action="{{ path('app_payer_complement', {id: reservation.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('payer-complement-' ~ reservation.id) }}">
                        <button class="button button--danger button--small" type="submit">Payer le complément d’annulation</button>
                    </form>
                {% endif %}
                {% if reservation.etat.value == 'annulee' and reservation.origineAnnulation and reservation.origineAnnulation.value == 'prestataire' and not reservation.choixAnnulation %}
                    <div class="provider-choice">
                        <p>Ti Baleine a annulé cette sortie. Choisissez une solution :</p>
                        <form method="post" action="{{ path('app_choix_remboursement', {id: reservation.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('remboursement-' ~ reservation.id) }}"><button class="button button--outline button--small">Remboursement intégral</button></form>
                        <form method="post" action="{{ path('app_choix_report', {id: reservation.id}) }}">
                            <select name="sortie" required><option value="">Nouveau créneau</option>{% for proposition in sorties_report %}{% if proposition.type == reservation.sortie.type and proposition.etat.value == 'planifiee' %}<option value="{{ proposition.id }}">{{ proposition.date|date('d/m/Y') }} à {{ proposition.heureDepart|date('H:i') }}</option>{% endif %}{% endfor %}</select>
                            <input type="hidden" name="_token" value="{{ csrf_token('report-' ~ reservation.id) }}"><button class="button button--primary button--small">Reporter</button>
                        </form>
                    </div>
                {% endif %}
                {% if reservation.etat.value == 'reservee' and reservation.sortie.depart > date() %}
                    <details class="cancel-request">
                        <summary>Demander une annulation</summary>
                        <form method="post" action="{{ path('app_demande_annulation', {id: reservation.id}) }}">
                            <label for="motif-{{ reservation.id }}">Motif</label>
                            <textarea id="motif-{{ reservation.id }}" name="motif" required>{{ reservation.motifAnnulation }}</textarea>
                            <input type="hidden" name="_token" value="{{ csrf_token('annulation-' ~ reservation.id) }}">
                            <button class="button button--danger button--small" type="submit">Envoyer la demande</button>
                        </form>
                    </details>
                {% endif %}
            </article>
        {% else %}
            <div class="empty-state"><h2>Aucune réservation</h2><p>Votre prochaine aventure commence dans le planning.</p><a class="button button--primary" href="{{ path('app_planning') }}">Voir les sorties</a></div>
        {% endfor %}
    </div>
</section>
{% endblock %}
